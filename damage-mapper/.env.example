# Copy this file to .env; never commit populated .env files.
DM_ENVIRONMENT=development
DATABASE_URL=sqlite:///./damage_mapper.db
DM_STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=incident-evidence
DM_CORS_ORIGINS=
DM_TRUSTED_HOSTS=

# Local mode: leave model downloads disabled for deterministic offline tests.
DM_DISABLE_MODEL=1
DM_ENABLE_DEMO=1
DM_CLIP_MODEL=openai/clip-vit-base-patch32
DM_YOLO_MODEL=
DM_AI_REVIEW_THRESHOLD=0.55

DM_MAX_UPLOAD_BYTES=10485760
DM_MAX_IMAGE_PIXELS=40000000
DM_ADMIN_BOOTSTRAP_SECRET=
DM_AUTH_TOKEN_TTL_MINUTES=480
DM_AUTH_LOGIN_LIMIT=10
DM_AUTH_REGISTER_LIMIT=5
DM_AUTH_UPLOAD_LIMIT=20

DM_HIGH_RISK_PRIORITY_THRESHOLD=75
DM_DUPLICATE_RADIUS_M=150
DM_DUPLICATE_WINDOW_HOURS=48
DM_DUPLICATE_HASH_DISTANCE=10
